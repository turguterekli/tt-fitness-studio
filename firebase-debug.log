[debug] [2026-11-15T08:36:16.420Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-ttfitness:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n// TT Fitness Studio — veritabanı erişim kuralları (güvenli mod).\n// Özet: giriş yapmamış kimse üye verisi okuyamaz; üye yalnızca KENDİ kayıtlarını görür;\n// salonun üye hakkında tuttuğu kayıtları üye okuyabilir ama değiştiremez; yönetim notlarını göremez.\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Gerçek (e-posta/şifre ile) giriş yapmış ve yetki belgesi olan kullanıcı\n    function signedIn() { return request.auth != null && request.auth.token.email != null; }\n    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }\n    function registered() { return signedIn() && exists(userPath()); }\n    function isAdmin() { return registered() && get(userPath()).data.role == 'admin'; }\n    function isMember(memberId) { return registered() && get(userPath()).data.memberId == memberId; }\n\n    // Herkese açık tek şey: uygulamanın hangi düzende çalışacağını söyleyen ayar\n    match /config/{doc} {\n      allow get: if true;\n      allow write: if isAdmin();\n    }\n    // Giriş dizini: telefon anahtarı → hesap nesli (yalnızca tek tek okunabilir, listelenemez)\n    match /login_index/{key} {\n      allow get: if true;\n      allow list, write: if isAdmin();\n    }\n    // Yetki belgeleri: rolü yalnızca yönetici yazar (üye kendi rolünü değiştiremez)\n    match /users/{uid} {\n      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());\n      allow list, create, update: if isAdmin();\n      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);\n    }\n    // Üye kaydı (ad, telefon, durum, su/kahve…)\n    match /members/{memberId} {\n      allow get: if isAdmin() || isMember(memberId);\n      allow list, create: if isAdmin();\n      allow delete: if isAdmin() || isMember(memberId);\n      // Üye kendi kaydında yalnızca \"hesabım aktif, geçici şifrem artık yok\" değişikliğini yapabilir\n      allow update: if isAdmin() || (isMember(memberId)\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'mustSetPassword', 'activationCode'])\n        && request.resource.data.get('status', 'active') == 'active'\n        && request.resource.data.get('mustSetPassword', true) == true);\n    }\n    // Üyenin kendi yazdıkları\n    match /member_self/{memberId} {\n      allow read, write: if isAdmin() || isMember(memberId);\n    }\n    // Salonun üye hakkında tuttukları: üye okur, değiştiremez (yalnızca hesabını silerken silebilir)\n    match /member_admin/{memberId} {\n      allow read: if isAdmin() || isMember(memberId);\n      allow create, update: if isAdmin();\n      allow delete: if isAdmin() || isMember(memberId);\n    }\n    // Yönetim notları: üye göremez\n    match /member_private/{memberId} {\n      allow read, create, update: if isAdmin();\n      allow delete: if isAdmin() || isMember(memberId);\n    }\n    match /trainers/{id} {\n      allow read: if registered();\n      allow write: if isAdmin();\n    }\n    // Ortak/yönetim verileri: üyeler yalnızca fiyat, sözleşme sürümü ve sıralama özetini okuyabilir\n    match /app_data/{docId} {\n      allow read, write: if isAdmin();\n      allow get: if registered() && docId in ['state_priceSettings', 'state_appMeta', 'state_leaderboardShared'];\n    }\n    // Şifre sıfırlama isteği: giriş yapmadan bırakılabilir, yalnızca yönetim okur/siler\n    match /reset_requests/{id} {\n      allow create: if request.resource.data.keys().hasOnly(['phone', 'date', 'code', 'ts'])\n        && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30\n        && request.resource.data.code is string && request.resource.data.code.size() == 6\n        && request.resource.data.date is string && request.resource.data.date.size() <= 10\n        && request.resource.data.ts is number;\n      allow read, delete: if isAdmin();\n    }\n    // Giriş kayıtları: herkes yalnızca kendi girişini yazar, yalnızca yönetim okur\n    match /login_log/{id} {\n      allow create: if registered() && request.resource.data.uid == request.auth.uid\n        && request.resource.data.keys().hasOnly(['uid', 'who', 'ok', 'reason', 'ts', 'date', 'time']);\n      allow read, delete: if isAdmin();\n    }\n    // Yukarıda sayılmayan her şey kapalı\n  }\n}\n"}]}}
